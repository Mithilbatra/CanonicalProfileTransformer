# Copy to `.env` (or set these in your host's dashboard). All are optional —
# the app runs on sensible defaults with none of them set.

# --- core ---
PORT=4000
# Where the candidate database (SQLite) lives. Point at a mounted volume in
# production so data survives redeploys.
DB_PATH=/app/data/app.db
# Public URL of the deployment — used to build password-reset / invite links.
APP_URL=https://your-app.example.com
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so client
# IPs (rate limiting) and https detection work.
TRUST_PROXY=1
# Turns on production behaviors (real email required for reset/invite, etc.).
NODE_ENV=production

# --- email (password reset + teammate invites) ---
# Without SMTP_URL the app logs links instead of sending mail (fine for dev).
# Example: smtps://user:pass@smtp.sendgrid.net:465
SMTP_URL=
MAIL_FROM=no-reply@your-app.example.com

# --- integrations ---
# Optional GitHub token to raise the enrichment API rate limit.
GITHUB_TOKEN=

# --- AI assist layer (semantic search, briefs, interview kits, outreach) ---
# With a key set, these call the model API. Without one, the app runs deterministic
# local drafts in dev (or when AI_MOCK=1); in production with no key the AI
# endpoints report 503 and the UI hides the features. Nothing AI-generated is
# written into the trusted candidate record — the outputs are drafts to verify.
ANTHROPIC_API_KEY=
# Pin a model (defaults to a current model id).
AI_MODEL=claude-opus-5
# Force the deterministic local drafts even with NODE_ENV=production (demo mode).
AI_MOCK=
# Default per-org cap on live AI requests per day (protects the shared key's
# spend). Admins can override per-org in the app. Default 200.
AI_DAILY_CAP=200

# --- limits & hardening ---
# Upload limits and a per-file extraction timeout (guards against slow/huge
# files tying up the process).
MAX_UPLOAD_MB=8
MAX_UPLOAD_FILES=20
MAX_OCR_MB=6
EXTRACT_TIMEOUT_MS=45000

# --- observability ---
# Log verbosity: debug | info | warn | error (default info). Logs are JSON in
# production, readable lines in dev.
LOG_LEVEL=info
# Optional error monitoring. Set a DSN AND install @sentry/node to forward
# server errors to Sentry; otherwise errors are logged to stderr only.
SENTRY_DSN=
